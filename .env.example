BOT_TOKEN=123456789:replace-a-real-token
# Create an application at https://my.telegram.org/apps. They are required to check t.me links.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-with-telegram-api-hash
REDIS_URL=redis://redis:6379/0

# Throughput/accuracy controls. Higher concurrency is not always faster on a real network.
# Telegram rate limits are much lower than ordinary HTTP concurrency.
CHECK_CONCURRENCY=5
CHECK_TOTAL_TIMEOUT_SECONDS=5.0

MAX_FILE_BYTES=2097152
MAX_URLS_PER_FILE=10000
JOB_TTL_SECONDS=86400
